{
  "compilerOptions": {
    "target": "ES2022",
    // page.evaluate 콜백은 브라우저에서 실행되므로 DOM 타입이 필요하다.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"]
}
