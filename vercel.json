{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/legal", "destination": "/legal/index.html" },
    { "source": "/legal/privacy-policy", "destination": "/legal/index.html" },
    { "source": "/legal/terms-of-service", "destination": "/legal/index.html" },
    { "source": "/legal/location-terms", "destination": "/legal/index.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
