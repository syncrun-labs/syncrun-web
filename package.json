{
  "name": "syncrun-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SyncRun 랜딩페이지 — 맞대면 그 자리에서 함께 뛰는 러닝 앱 (React · React Bits · Liquid Glass)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next start -p 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:report": "playwright show-report",
    "lighthouse": "lhci collect --config=./lighthouserc.cjs",
    "lighthouse:local": "LHCI_BASE_URL=http://localhost:4173 lhci collect --config=./lighthouserc.cjs --start-server-command='npm run preview -- --port 4173 --strictPort' --start-server-ready-pattern='Local'",
    "lighthouse:report": "node scripts/lighthouse-summary.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "^16.3.5",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  }
}
