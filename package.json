{
  "name": "syncrun-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SyncRun 랜딩페이지 — 맞대면 그 자리에서 함께 뛰는 러닝 앱 (React · React Bits · Liquid Glass)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:report": "playwright show-report",
    "lighthouse": "lhci collect --config=./lighthouserc.cjs",
    "lighthouse:local": "lhci collect --config=./lighthouserc.cjs --start-server-command='npm run preview -- --port 4173 --strictPort' --start-server-ready-pattern='Local'",
    "lighthouse:report": "node scripts/lighthouse-summary.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "ogl": "^1.0.11",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.10"
  }
}
